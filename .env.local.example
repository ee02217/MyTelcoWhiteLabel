# Local Docker integration environment variables
# Copy to .env.local and adjust if needed.

POSTGRES_DB=mytelco
POSTGRES_USER=mytelco
POSTGRES_PASSWORD=mytelco
POSTGRES_PORT=5432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

KONG_PROXY_PORT=8000
KONG_ADMIN_PORT=8001
KONG_PROXY_TLS_PORT=8443
KONG_ADMIN_TLS_PORT=8444

CUSTOMER_BFF_PORT=8081
ADMIN_BFF_PORT=8082
WEB_PORTAL_PORT=3000
ADMIN_PORTAL_PORT=3001
WEB_PORTAL_API_UPSTREAM=http://kong:8000
ADMIN_PORTAL_API_UPSTREAM=http://kong:8000

SPRING_PROFILES_ACTIVE=local

# Internal OIDC endpoints for service-to-service validation inside Docker network
INTERNAL_OIDC_ISSUER=http://keycloak:8080/realms/mytelco-white-label
INTERNAL_OIDC_JWKS_URI=http://keycloak:8080/realms/mytelco-white-label/protocol/openid-connect/certs

# OIDC local callbacks/client wiring (browser/mobile)
OIDC_ISSUER=http://localhost:8080/realms/mytelco-white-label
WEB_OIDC_CLIENT_ID=web-portal
WEB_OIDC_REDIRECT_URI=http://localhost:5173/callback
WEB_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173
MOBILE_OIDC_CLIENT_ID=mobile-app
MOBILE_OIDC_REDIRECT_URI=mytelco://oauth/callback
OIDC_SCOPES="openid roles"

# OIDC values baked into dockerized SPA builds (local compose)
WEB_OIDC_ISSUER=http://localhost:8080/realms/mytelco-white-label
WEB_OIDC_REDIRECT_URI_DOCKER=http://localhost:3000/callback
WEB_OIDC_POST_LOGOUT_REDIRECT_URI_DOCKER=http://localhost:3000
WEB_OIDC_SCOPES="openid roles"

ADMIN_OIDC_ISSUER=http://localhost:8080/realms/mytelco-white-label
ADMIN_OIDC_REDIRECT_URI_DOCKER=http://localhost:3001/callback
ADMIN_OIDC_POST_LOGOUT_REDIRECT_URI_DOCKER=http://localhost:3001
ADMIN_OIDC_SCOPES="openid roles"

# Event backbone dispatcher mode (stub|kafka)
MYTELCO_EVENTS_DISPATCH_MODE=stub
# Used when MYTELCO_EVENTS_DISPATCH_MODE=kafka
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SPRING_KAFKA_PRODUCER_MAX_BLOCK_MS=3000
SPRING_KAFKA_PRODUCER_REQUEST_TIMEOUT_MS=2000
SPRING_KAFKA_PRODUCER_DELIVERY_TIMEOUT_MS=5000
KAFKA_PORT=9092
KAFKA_KRAFT_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
