{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytelco.local/schemas/journey.schema.json",
  "title": "Operator Journey Configuration",
  "type": "object",
  "required": ["operatorId", "journeyId", "version", "steps"],
  "properties": {
    "operatorId": { "type": "string", "minLength": 1 },
    "journeyId": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "required": ["order", "id", "type", "condition"],
      "properties": {
        "order": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
