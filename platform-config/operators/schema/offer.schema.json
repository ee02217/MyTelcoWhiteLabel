{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mytelco.dev/schema/operator-offer.json",
  "title": "Operator Offer",
  "type": "object",
  "required": ["offerId", "versions"],
  "properties": {
    "offerId": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "operatorId": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "version",
          "state",
          "name",
          "description",
          "eligibilityRules",
          "visibleChannels",
          "author",
          "updatedAt"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "type": "string",
            "enum": ["DRAFT", "APPROVAL", "PUBLISHED", "RETIRED"]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "eligibilityRules": {
            "type": "object",
            "additionalProperties": true
          },
          "visibleChannels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["web", "mobile", "admin", "partner"]
            }
          },
          "notes": {
            "type": ["string", "null"]
          },
          "author": {
            "type": "string",
            "minLength": 1
          },
          "reviewer": {
            "type": ["string", "null"]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
