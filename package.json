{
  "name": "my-telco-white-label",
  "version": "1.0.0",
  "description": "Mono-repo for Telco Self-Care White-Label Platform",
  "private": true,
  "scripts": {
    "bootstrap:node": "node scripts/bootstrap-node-modules.mjs",
    "bootstrap:node:skip-root": "node scripts/bootstrap-node-modules.mjs --skip-root",
    "lint:changed": "node scripts/run-changed.mjs lint",
    "test:changed": "node scripts/run-changed.mjs test",
    "build:changed": "node scripts/run-changed.mjs build",
    "lint:all": "node scripts/run-changed.mjs lint --all",
    "test:all": "node scripts/run-changed.mjs test --all",
    "build:all": "node scripts/run-changed.mjs build --all",
    "quality:all": "npm run bootstrap:node && npm run lint:all && npm run build:all",
    "repo:verify": "echo 'Repository structure verified'"
  },
  "keywords": [
    "telco",
    "self-care",
    "white-label",
    "monorepo"
  ],
  "author": "",
