# Kong production profile variables
# Copy to your secret-managed environment (do not commit real values).

# Upstream service DNS inside production cluster/network
KONG_CUSTOMER_BFF_UPSTREAM=customer-bff.platform.svc.cluster.local:8081
KONG_ADMIN_BFF_UPSTREAM=admin-bff.platform.svc.cluster.local:8082

# Explicit CORS allow-lists (no wildcards)
KONG_CUSTOMER_WEB_ORIGIN=https://selfcare.example.com
KONG_ADMIN_WEB_ORIGIN=https://admin.example.com
KONG_MOBILE_WEBVIEW_ORIGIN=https://mobile-webview.example.com

# OIDC/JWT perimeter validation
KONG_OIDC_ISSUER=https://id.example.com/realms/mytelco-white-label
KONG_OIDC_JWKS_URI=https://id.example.com/realms/mytelco-white-label/protocol/openid-connect/certs
KONG_OIDC_AUDIENCE=mytelco-api

# Rate limits
KONG_RATE_LIMIT_CUSTOMER_PER_MINUTE=100
KONG_RATE_LIMIT_ADMIN_PER_MINUTE=50
