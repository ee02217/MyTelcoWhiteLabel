{
  "name": "mobile-app",
  "version": "1.0.0",
  "description": "Mobile application - React Native with Expo",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "build": "expo export",
    "build:android": "npm run native:prebuild && expo run:android",
    "build:ios": "npm run native:prebuild && expo run:ios",
    "native:prebuild": "expo prebuild",
    "test": "echo 'No tests configured yet'"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.2",
    "@react-native-async-storage/async-storage": "^3.0.1",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-auth-session": "~6.0.3",
    "expo-file-system": "^55.0.10",
    "expo-router": "~4.0.22",
    "expo-sharing": "^55.0.11",
    "expo-status-bar": "^55.0.4",
    "expo-web-browser": "~14.0.2",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "@types/react-native": "^0.73.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~7.1.2",
    "typescript": "~5.3.3"
  }
}
