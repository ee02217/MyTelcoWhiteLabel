{
  "expo": {
    "name": "MyTelco",
    "slug": "my-telco-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0073e6"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mytelco.white-label"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0073e6"
      },
      "package": "com.mytelco.whitelabel"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset"
    ]
  }
}
